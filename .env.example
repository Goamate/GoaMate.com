# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Database & Auth Configuration
# Public keys used by client queries if connecting directly:
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only Supabase Service Role Key (Keep secret on server, never expose to client):
SUPABASE_SERVICE_ROLE_KEY=""

# Admin bootstrap token (for initial super-admin assignment):
ADMIN_BOOTSTRAP_SECRET="goamate-admin-secret-2026"

# Optional Email Integration (Leave blank to use dashboard notifications):
EMAIL_API_KEY=""
EMAIL_FROM="GoaMate <notifications@goamate.com>"

